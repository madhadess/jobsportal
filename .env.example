APP_NAME="Job Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOG=single
APP_LOG_LEVEL=debug

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jobsportal
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
FILESYSTEM_DRIVER=local
FILESYSTEM_CLOUD=s3
QUEUE_CONNECTION=sync
QUEUE_DRIVER=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_CONNECTION=
SESSION_STORE=
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=

MEMCACHED_PERSISTENT_ID=
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_DRIVER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_RECEIVE_TO_ADDRESS=
MAIL_RECEIVE_TO_NAME="${APP_NAME}"
MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Stripe
STRIPE_KEY=
STRIPE_SECRET=

# Razorpay
RAZORPAY_KEY=
RAZORPAY_SECRET=

# PayPal (config/paypal.php - site settings may override)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# PayU
PAYU_DEFAULT_GATEWAY=biz
PAYU_MONEY_MODE=test
PAYU_MONEY_KEY=
PAYU_MONEY_SALT=
PAYU_MONEY_AUTH=
PAYU_BIZ_MODE=test
PAYU_BIZ_KEY=
PAYU_BIZ_SALT=

# reCAPTCHA
NOCAPTCHA_SECRET=
NOCAPTCHA_SITEKEY=

# Mailchimp (newsletter)
MAILCHIMP_APIKEY=
MAILCHIMP_LIST_ID=

# Snappy / wkhtmltopdf (PDF export). Windows: full path; Linux: wkhtmltopdf
WKHTMLTOPDF_BINARY=wkhtmltopdf
WKHTMLTOIMAGE_BINARY=wkhtmltoimage

# Optional: protect run-permissions-update route with ?key= value
RUN_UPDATE_KEY=

# Flare / Ignition (error reporting)
FLARE_KEY=
IGNITION_EDITOR=phpstorm
IGNITION_THEME=light
IGNITION_SHARING_ENABLED=true
REGISTER_IGNITION_COMMANDS=false

# Datatables
DATATABLES_ERROR=

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
