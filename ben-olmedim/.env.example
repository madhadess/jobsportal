# --- Yapay zekâ görsel/video üretimi (isteğe bağlı) ---
# Biri tanımlıysa `npm run media -- <bölüm>` eksik sahneleri üretir.
# Hiçbiri yoksa hiçbir şey üretilmez; eksikler reports/missing-media.json'a yazılır.

# MEDIA_PROVIDER=replicate        # replicate | fal (boşsa hangisinin anahtarı varsa o)

# Replicate — https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=
# REPLICATE_VIDEO_MODEL=kwaivgi/kling-v2.1
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-1.1-pro
# REPLICATE_REF_IMAGE_KEY=start_image   # karakter referans görselinin gönderileceği girdi adı

# fal.ai — https://fal.ai/dashboard/keys
# FAL_KEY=
# FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/master/text-to-video
# FAL_IMAGE_MODEL=fal-ai/flux-pro/v1.1
# FAL_REF_IMAGE_KEY=image_url

# --- Render ---
# REMOTION_BROWSER=/yol/chrome-headless-shell   # boşsa Remotion kendi tarayıcısını kullanır
# RENDER_CONCURRENCY=4
